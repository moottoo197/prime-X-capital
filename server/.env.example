# Alphavest Production Environment Configuration
# Copy this file to `/server/.env` (outside `public_html/`) and populate your real credentials.
# Never commit `/server/.env` or expose it inside `public_html/`.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_OR_SECRET_KEY

DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.your-project-ref.supabase.co:5432/postgres
PGHOST=db.your-project-ref.supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=YOUR_DB_PASSWORD
DB_DRIVER=supabase

# --- Application Security & Sessions (Required) ---
APP_SECRET=replace_with_a_long_random_hex_secret

# --- Admin Authentication ---
ADMIN_EMAILS=trader@alphavest.io
ADMIN_MASTER_PASSWORD=

# --- CORS Allowed Origins (Comma-separated) ---
ALLOWED_ORIGINS=https://prime-x-capital.com,https://www.prime-x-capital.com

# --- Cron Protection ---
CRON_SECRET=replace_with_a_strong_random_cron_secret

# --- SMTP / Email Dispatch (Optional) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=noreply@prime-x-capital.com
SMTP_FROM_NAME=PRIME X CAPITAL

# --- Supabase Storage Buckets ---
STORAGE_BUCKET_KYC=kyc-documents
STORAGE_BUCKET_PRIVATE=private-user-files
STORAGE_BUCKET_MARKETING=marketing-assets
